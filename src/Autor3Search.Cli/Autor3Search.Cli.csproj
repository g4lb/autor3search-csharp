<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Autor3Search.Core\Autor3Search.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>autor3search-csharp</ToolCommandName>
    <PackageId>autor3search-csharp</PackageId>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <Description>Autonomous AI-driven performance optimization for any .NET repository.</Description>
    <PackageProjectUrl>https://github.com/autor3search/csharp</PackageProjectUrl>
    <PackageTags>benchmark;performance;optimization;benchmarkdotnet;agent;ai;cli;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Without this the nuget.org page shows only Description. -->
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Autor3Search.Cli.Tests" />
  </ItemGroup>

</Project>
